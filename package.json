{
  "name": "korean-report-skills",
  "version": "1.16.0",
  "description": "한국어 기술·사업 문서의 자립형 HTML 제작과 문체·프레이밍·정확성 검토를 제공하는 Agent Skills",
  "license": "Apache-2.0",
  "private": false,
  "type": "commonjs",
  "main": "./.opencode/plugins/korean-report.mjs",
  "exports": {
    ".": "./.opencode/plugins/korean-report.mjs",
    "./plugin": "./.opencode/plugins/korean-report.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:skills": "node bin/install.js",
    "new": "node scripts/run-python.js scripts/new-document.py",
    "build:example": "node scripts/run-python.js examples/build_example.py",
    "pack": "bash scripts/pack-skills.sh",
    "test:package": "node scripts/package-smoke.js",
    "test:node": "node scripts/run-node-tests.js",
    "test:py": "node scripts/run-python.js -m pytest tests/ -q",
    "test": "npm run test:package && npm run test:node && npm run test:py",
    "check:release-tag": "node scripts/check-release-tag.js"
  },
  "dependencies": {
    "katex": "^0.16.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JangHyun-bin/korean-report-skills.git"
  },
  "keywords": [
    "agent-skills",
    "opencode-plugin",
    "opencode",
    "claude-code",
    "codex",
    "cursor",
    "korean",
    "technical-writing",
    "html-report",
    "pdf",
    "document-qa",
    "sarif",
    "katex"
  ],
  "bin": {
    "korean-report-skills": "bin/install.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "plugins/",
    "scripts/",
    ".claude-plugin/",
    ".opencode/",
    ".github/",
    "docs/assets/",
    "docs/design/",
    "examples/",
    "tests/",
    "pyproject.toml",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "INSTALL.md",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo"
  ]
}
