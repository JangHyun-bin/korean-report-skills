# 저장소에는 항상 LF 로 담는다.
* text=auto eol=lf

# 셸 스크립트가 CRLF 로 들어가면 CI 의 bash 가 "\r: command not found" 로 죽는다.
*.sh   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.json text eol=lf

# 이진 파일
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
*.png   binary
*.pdf   binary
*.skill binary

# 언어 통계에서 뺀다
examples/** linguist-documentation
